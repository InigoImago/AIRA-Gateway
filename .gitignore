deploy/compose/docker-compose.sandbox.yml

# Artefact of a live functional run (tools/… scratch), never source.
matrix-result.json

# The marker `--verify` reads: one path, no secrets. Local to an installation.
.aira-config-source

# Certificates for the collector's two outgoing channels — a private CA, and a client certificate
# and key where a destination asks for one (`AIRA_OTEL_BACKEND_*`, `AIRA_OTEL_FORWARD_*`). The
# directory and its README are tracked so the mount point exists; what it holds is the
# installation's, and a private key is a secret.
deploy/compose/otel/ca/*
!deploy/compose/otel/ca/README.md

# An installation's own collector fragments and the values its recipes read (ADR-0024). The README
# is tracked so the mount point exists.
deploy/compose/otel/custom/*
!deploy/compose/otel/custom/README.md
