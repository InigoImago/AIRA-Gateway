# nginx configuration for the management SPA.
#
# In development the Angular dev server proxies /api and /gw (proxy.conf.json). In a container
# there is no dev server, so nginx takes over that job — the SPA must keep calling same-origin
# paths, otherwise every request becomes a cross-origin one and the bearer token would have to
# be sent to a third origin.
#
# Upstreams are substituted from the environment at container start (the official nginx image
# renders /etc/nginx/templates/*.template with envsubst).

server {
    listen       8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Re-resolve the upstream names instead of pinning whatever they meant at startup.
    #
    # nginx resolves a literal hostname in `proxy_pass` exactly once, when the configuration is
    # loaded, and then keeps that address for the life of the process. Every container restart
    # gives the gateway or management a new address, so a redeploy of either left this proxy
    # talking to an address nobody was listening on — and the SPA reported "the gateway could not
    # be reached" until somebody thought to restart nginx as well. Nothing else surfaced it: the
    # services themselves were healthy the whole time.
    #
    # Passing the upstream through a variable defers resolution to request time, and the resolver
    # below is what makes that possible. 127.0.0.11 is Docker's embedded DNS; override it where
    # the platform provides a different one.
    resolver ${AIRA_DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # The bundle is content-hashed, so it can be cached hard.
    location ~* \.(js|css|woff2?|png|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must never be cached: it names the current hashed bundles.
    #
    # And it is the one response a browser *executes*, so it is the one that needs the headers
    # below. They were absent entirely: the gateway sets its own (`SecurityHeadersMiddleware`) and
    # Django sets its own (`SECURE_*`), and the document those two are read from had none — no
    # content policy, no `nosniff`, no framing rule, no referrer rule, on a governance console.
    #
    # Repeated in `location /` rather than declared once at server level, because nginx's
    # `add_header` **replaces** the inherited set as soon as a location declares one of its own.
    # A single server-level block would silently vanish here, which is the failure mode that makes
    # this worth stating.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/aira-headers.inc;
        try_files $uri =404;
    }

    location /api/ {
        # A variable in proxy_pass passes the request URI through unchanged, which is what this
        # location wants: management serves the /api prefix itself.
        set              $management_upstream ${AIRA_MANAGEMENT_UPSTREAM};
        proxy_pass       $management_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The gateway is mounted under /gw for the SPA; strip the prefix before forwarding.
    location /gw/ {
        # The prefix is stripped explicitly here. With a literal upstream a trailing "/" in
        # proxy_pass would do it, but that form resolves the name once and never again — and a
        # variable form passes the URI through untouched, so the rewrite has to be spelled out.
        set              $gateway_upstream ${AIRA_GATEWAY_UPSTREAM};
        rewrite          ^/gw/(.*)$ /$1 break;
        proxy_pass       $gateway_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # **Nothing here may be buffered.** The gateway serves SSE on two verbs —
        # `:streamGenerateContent?alt=sse` and `/kira/api/external/streaming-chat` — and nginx
        # buffers proxied responses by default, so every one of them arrived as a single lump at
        # the end. That is exactly the defect `streaming_chat` documents having fixed inside the
        # gateway ("a caller saw a blank view for the length of the whole answer and then all of it
        # at once — no error, no message, just worse"), reintroduced one layer further out where
        # no gateway test can see it.
        proxy_buffering    off;
        proxy_cache        off;
        # HTTP/1.1 with no `Connection: close`, or the upstream cannot stream at all.
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        # Longer than the gateway's own patience, never shorter. `AIRA_OLLAMA_TIMEOUT_SECONDS`
        # defaults to 300 because a cold self-deployed model loads for a minute or more
        # (`ADR-0012` §5) — at 120s the proxy gave up first, so a cold start reached the reader as
        # a `504` from nginx instead of the gateway's own diagnosis. A stream that is still
        # producing resets this timer per chunk; a stalled upstream still ends.
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
    }

    # Angular owns the routing: anything else is a client-side route.
    location / {
        include /etc/nginx/conf.d/aira-headers.inc;
        try_files $uri $uri/ /index.html;
    }
}
