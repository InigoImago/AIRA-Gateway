# Response headers for the document a browser executes — the console's own HTML.
#
# `included` from every location that serves HTML rather than declared once at server level: nginx's
# `add_header` **replaces** the inherited set the moment a location declares one of its own, and
# `location = /index.html` declares `Cache-Control`. A single server-level block would therefore be
# silently dropped on exactly the response that needs it, which is why this is a file and not four
# copies somebody keeps in step by hand.
#
# `always`, so they are present on error responses too. A 404 from this server is still HTML the
# browser renders.
#
# The gateway states its own reasoning for the equivalent set in `SecurityHeadersMiddleware`; this
# is the SPA's half, and it had none at all.

# Stops a browser second-guessing a declared type. The one header on this list that has ever
# mattered here in practice.
add_header X-Content-Type-Options "nosniff" always;

# Nothing served here is meant to be embedded. Stated twice on purpose — the header for browsers
# that do not implement `frame-ancestors`, the directive for those that ignore the header.
add_header X-Frame-Options "DENY" always;

# The console's URLs carry use-case slugs and request ids. `strict-origin-when-cross-origin` keeps
# the path off any outbound request while leaving same-origin navigation intact.
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# The console asks for no camera, microphone or location, so it says so.
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

# The content policy.
#
# Every directive here is what the application actually needs, and the two that are looser than
# `'self'` say why:
#
#   style-src  'unsafe-inline'  Angular emits component styles as inline <style> elements at
#                               runtime. Removing it does not harden anything and does break the
#                               console's rendering entirely.
#   img/font   data:            inline SVG marks and the icon font.
#
# `connect-src` follows the issuer. The SPA calls its own origin for `/api` and `/gw`, and
# Keycloak's token endpoint cross-origin — and the issuer is deployment configuration, so it cannot
# be baked in here. `10-runtime-config.envsh` derives `AIRA_CSP_CONNECT_SRC` from `AIRA_OIDC_ISSUER`
# at container start unless it is set explicitly, so a deployment sets the issuer and nothing else.
# This header is the only place the issuer is named: the policy compiled into `index.html` leaves
# connections open, and a browser enforces both.
#
# `frame-src 'none'`: the console frames nothing. It renews a session with the refresh token the
# code flow returns (`auth.config.ts`), so no hidden iframe has to load the issuer.
# `frame-ancestors 'none'`, `object-src 'none'` and `base-uri 'self'` cost nothing and close the
# three tricks that need no script of their own.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ${AIRA_CSP_CONNECT_SRC}; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
