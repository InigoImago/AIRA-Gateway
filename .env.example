# AIRA local secrets — copy to `.env` and fill in real values. NEVER commit `.env`.
# Every AIRA service reads these (env_prefix = "AIRA_"); `.env` is loaded from the
# process working directory (repo root for `make run-gateway`).

# Real Google Gemini upstream (FRD-304). Without this the gateway serves only the mock.
AIRA_GOOGLE_API_KEY=

# Optional overrides (defaults shown):
# AIRA_GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash
# AIRA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Gateway OIDC (ADR-0007) ----------------------------------------------------------
# Enable so the gateway can verify the *same* Keycloak token the management SPA already
# holds. Required for the builder's pipeline dry-run and the budget-consumption view, which
# are authenticated endpoints. Set an audience in real deployments so a token minted for a
# different client is not accepted.
# AIRA_OIDC_ENABLED=true
# AIRA_OIDC_ISSUER=http://localhost:8080/realms/aira
# AIRA_OIDC_AUDIENCE=aira-gateway

# ---- Gateway request hardening (ADR-0007) ---------------------------------------------
# Honour X-Forwarded-For for the recorded source IP. Only turn this on when the gateway sits
# behind a reverse proxy that *overwrites* the header — otherwise clients can forge the audit
# trail. Default: off (the socket peer is recorded).
# AIRA_TRUST_FORWARDED_FOR=false
# Hard ceiling on an accepted request body, in bytes (default 8 MiB).
# AIRA_MAX_REQUEST_BYTES=8388608

# ---- Management deployment (ADR-0007) -------------------------------------------------
# Outside `local`, the management backend refuses to start while it still carries the
# development defaults. Set these from Vault for anything that is not a laptop.
# AIRA_ENVIRONMENT=production
# AIRA_SECRET_KEY=<unique-random-secret>
# AIRA_ALLOWED_HOSTS=aira.example.com
# AIRA_DEBUG=false
