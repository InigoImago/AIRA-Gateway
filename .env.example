# AIRA local secrets — copy to `.env` and fill in real values. NEVER commit `.env`.
# The settings classes (env_prefix = "AIRA_") read `.env` from the process's working directory:
# the repo root for `make run-gateway`, so this file reaches the gateway run from source.
# `make run-backend` runs Management from `management/backend`, where it reads
# `management/backend/.env` and not this file.
#
# ---------------------------------------------------------------------------------------------
# THIS IS THE **DEVELOPMENT** FILE, AND IT IS DELIBERATELY NOT THE WHOLE CONTRACT.
#
# It carries what you override when running a service **from source** against `make up` — mostly
# credentials for upstreams the Compose stack cannot provide for you. The settings a *deployment*
# is configured with live in the file that stack copies:
#
#     deploy/compose/.env.example      every setting, what it does, and four ready-made
#                                      combinations for demo / dev / integrating / production
#     docs/CONFIGURATION.md            the same list with what breaks when each is wrong
#
# A setting absent from *this* file is not a setting that does not exist. Anything in the two
# references above works here too, for whichever process reads this file.
# ---------------------------------------------------------------------------------------------

# Google AI Studio (FRD-304): one key, Google's public endpoint. Without it, or another upstream
# below, a gateway run from source serves only the mock.
#
# **Its region is `global`**, which the default AIRA_ALLOWED_REGIONS (the EU regions) does not
# contain: set the key alone and the gateway refuses to start. Naming `global` is a decision about
# residency, so it is written down rather than defaulted — the list replaces the default, so name
# every region you use. Vertex (deploy/compose/.env.example) is the regional path.
AIRA_GOOGLE_API_KEY=
# AIRA_ALLOWED_REGIONS=global

# Optional. Which models to offer — empty by default: the catalog's discovery asks the key what it
# serves (FRD-507). The base URL keeps its /v1beta: the adapter appends /models/<model>:<method>.
# AIRA_GEMINI_MODELS=gemini-2.5-flash
# AIRA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Gateway OIDC (ADR-0007) ----------------------------------------------------------
# Enable so the gateway can verify the *same* Keycloak token the console already holds.
# Required for every console screen that asks the gateway — dry runs, budget consumption,
# reports, incidents, the catalogue's discovery and model checks, smoke tests
# (`make run-gateway-oidc` turns it on). Set an audience in real deployments so a token minted
# for a different client is not accepted.
# AIRA_OIDC_ENABLED=true
# AIRA_OIDC_ISSUER=http://localhost:8080/realms/aira
# AIRA_OIDC_AUDIENCE=aira-gateway

# ---- Gateway request hardening (ADR-0007) ---------------------------------------------
# Honour X-Forwarded-For for the recorded source IP. Only turn this on when the gateway sits
# behind reverse proxies you control. They *append* to the header (nginx:
# `$proxy_add_x_forwarded_for`), so the address is read AIRA_TRUSTED_PROXY_HOPS entries from the
# right, and everything left of that is whatever the caller sent. Default: off (the socket peer
# is recorded).
# AIRA_TRUST_FORWARDED_FOR=false
# AIRA_TRUSTED_PROXY_HOPS=1
# Hard ceiling on an accepted request body, in bytes (default 8 MiB).
# AIRA_MAX_REQUEST_BYTES=8388608

# ---- A real model, locally (FRD-123) --------------------------------------------------
# Registered ONLY when a URL is set. Not part of the reference deployment: its purpose is to make
# the whole governed path — stored prompts, real token counts, cost, roles, budgets — observable
# against something that did not agree with us by construction. `make verify-up` starts it.
#
# The endpoint is unauthenticated, so it must stay on a private network.
# AIRA_OLLAMA_URL=http://localhost:11434
# AIRA_OLLAMA_MODELS=qwen3:0.6b
# AIRA_OLLAMA_EMBEDDING_MODELS=all-minilm
# Recorded on every audit row. A self-hosted model is the strongest residency story available, and
# one that nothing records is a claim rather than evidence.
# AIRA_OLLAMA_REGION=on-premises
# Generous on purpose: a cold self-deployed model loads for a minute or more, and treating that as
# an outage is the first way to get a self-deployed endpoint wrong.
# AIRA_OLLAMA_TIMEOUT_SECONDS=300

# ---- Response schemas and embedding batches (FRD-112, FRD-113) ------------------------
# A response schema is caller-supplied structure whose recursion is caller-controlled. It is
# forwarded and never executed, so these bounds are the whole of the gateway's exposure to it.
# AIRA_MAX_RESPONSE_SCHEMA_BYTES=32768
# AIRA_MAX_RESPONSE_SCHEMA_DEPTH=8
# AIRA_MAX_RESPONSE_SCHEMA_PROPERTIES=256
#
# Embedding batch bounds. **Choose these with the configured rate limits in view**: a batch of n
# texts weighs n against a use case's bucket, so a batch bound larger than any bucket's capacity
# makes large batches fail permanently. The refusal names which of the two said no.
# AIRA_MAX_EMBEDDING_BATCH=256
# AIRA_MAX_EMBEDDING_CHARS=1000000

# ---- Management deployment (ADR-0007) -------------------------------------------------
# Outside `local`, the management backend refuses to start while it still carries the
# development defaults — `AIRA_DEBUG=true` among them. The secret key comes from Vault for
# anything that is not a laptop. (Management reads these from its own working directory's `.env`;
# see the top of this file.)
# AIRA_ENVIRONMENT=production
# AIRA_SECRET_KEY=<unique-random-secret>
# AIRA_ALLOWED_HOSTS=aira.example.com
# AIRA_DEBUG=false

# ---- Microsoft Foundry / Azure OpenAI (FRD-120) ----------------------------------------
# Registered when the endpoint and at least one deployment are set; without a key beside them
# the gateway refuses to start rather than answer 401 to every request.
# A deployment name is chosen by whoever created the resource and says nothing reliable about the
# model — so the mapping is declared, never inferred. Getting it wrong does not fail: a deployment
# name has no price, and unpriced traffic is counted apart rather than as zero, so the spend figure
# would quietly stop being complete.
#   model=deployment|region[|embed], entries separated by ';' — the region is required
# AIRA_FOUNDRY_ENDPOINT=https://contoso.openai.azure.com
# AIRA_FOUNDRY_API_KEY=
# AIRA_FOUNDRY_DEPLOYMENTS=gpt-4o=prod-gpt4o|westeurope;text-embedding-3-small=prod-emb|westeurope|embed
# Pinned rather than "latest": a version that moves on its own changes response shapes with no
# deploy, and the first sign is a mapper reading a field that stopped being sent.
# AIRA_FOUNDRY_API_VERSION=2024-10-21

# ---- Secrets (FRD-116) ----------------------------------------------------------------
# Vault is used only when VAULT_ADDR is set **and** VAULT_ROLE_ID (AppRole) or VAULT_TOKEN is.
# An address alone reads nothing and says nothing: every secret then comes from the environment,
# as with no address at all. Used, Vault wins over the environment, and a Vault that cannot be
# reached **stops the process** rather than falling back — the fallback is what turns a broken
# secret store into a service that starts, looks healthy, and runs on a stale value.
# VAULT_ADDR=https://vault.internal:8200
# VAULT_MOUNT=secret
# VAULT_PATH=aira
# VAULT_NAMESPACE=
# The role id identifies and does not authorise, so it is ordinary configuration.
# VAULT_ROLE_ID=
# The secret-id *is* a secret and must arrive by a path Vault did not provide:
#   VAULT_SECRET_ID       — an environment variable (CI, simple deployments); wins if both are set
#   VAULT_SECRET_ID_FILE  — a mounted file (Kubernetes projected volume: tmpfs, not a manifest)
# VAULT_TOKEN instead of a role id: a token, used only while VAULT_ROLE_ID is empty. For the
# dev-mode Vault `make up` runs, whose root token is `root`; every use logs a warning.

# ---- Diagnostics (FRD-117) ------------------------------------------------------------
# Cross-origin access: an allow-list, empty by default. `*` together with credentials refuses to
# start — browsers reject the combination, and a server that reflects the origin instead lets any
# site a user visits call this API with their credentials.
# AIRA_CORS_ORIGINS=https://aira.example
# AIRA_CORS_ALLOW_CREDENTIALS=false

# ---- Watching a call to another system (FRD-617, ADR-0022) ----------------------------
# One structured log line per call this service makes to a system that is not ours: what went
# where, how long it took, and what came back. For the days when something is being integrated
# and "did we send it, and did it arrive" has no answer anywhere.
#
# Empty is off and is what a working installation runs. Off costs one set membership test per
# call site. Names: otel, kafka, auth, vault, redis, postgres — or `all`. A name this build does
# not know refuses the process at start-up rather than watching nothing.
#
# No second switch: the lines are INFO (WARNING when the call failed), so this variable alone is
# enough — you do not also need AIRA_LOG_LEVEL=DEBUG.
# AIRA_DEBUG_INTEGRATIONS=otel,kafka
