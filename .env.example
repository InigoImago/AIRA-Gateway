# AIRA local secrets — copy to `.env` and fill in real values. NEVER commit `.env`.
# Every AIRA service reads these (env_prefix = "AIRA_"); `.env` is loaded from the
# process working directory (repo root for `make run-gateway`).

# Real Google Gemini upstream (FRD-304). Without this the gateway serves only the mock.
AIRA_GOOGLE_API_KEY=

# Optional overrides (defaults shown):
# AIRA_GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash
# AIRA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
