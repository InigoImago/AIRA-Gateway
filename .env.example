# AIRA local secrets — copy to `.env` and fill in real values. NEVER commit `.env`.
# Every AIRA service reads these (env_prefix = "AIRA_"); `.env` is loaded from the
# process working directory (repo root for `make run-gateway`).

# Real Google Gemini upstream (FRD-304). Without this the gateway serves only the mock.
AIRA_GOOGLE_API_KEY=

# Optional overrides (defaults shown):
# AIRA_GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash
# AIRA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Gateway OIDC (ADR-0007) ----------------------------------------------------------
# Enable so the gateway can verify the *same* Keycloak token the management SPA already
# holds. Required for the builder's pipeline dry-run and the budget-consumption view, which
# are authenticated endpoints. Set an audience in real deployments so a token minted for a
# different client is not accepted.
# AIRA_OIDC_ENABLED=true
# AIRA_OIDC_ISSUER=http://localhost:8080/realms/aira
# AIRA_OIDC_AUDIENCE=aira-gateway

# ---- Gateway request hardening (ADR-0007) ---------------------------------------------
# Honour X-Forwarded-For for the recorded source IP. Only turn this on when the gateway sits
# behind a reverse proxy that *overwrites* the header — otherwise clients can forge the audit
# trail. Default: off (the socket peer is recorded).
# AIRA_TRUST_FORWARDED_FOR=false
# Hard ceiling on an accepted request body, in bytes (default 8 MiB).
# AIRA_MAX_REQUEST_BYTES=8388608

# ---- A real model, locally (FRD-123) --------------------------------------------------
# Registered ONLY when a URL is set. Not part of the reference deployment: its purpose is to make
# the whole governed path — stored prompts, real token counts, cost, roles, budgets — observable
# against something that did not agree with us by construction. `make verify-up` starts it.
#
# The endpoint is unauthenticated, so it must stay on a private network.
# AIRA_OLLAMA_URL=http://localhost:11434
# AIRA_OLLAMA_MODELS=qwen3:0.6b
# AIRA_OLLAMA_EMBEDDING_MODELS=all-minilm
# Recorded on every audit row. A self-hosted model is the strongest residency story available, and
# one that nothing records is a claim rather than evidence.
# AIRA_OLLAMA_REGION=on-premises
# Generous on purpose: a cold self-deployed model loads for a minute or more, and treating that as
# an outage is the first way to get a self-deployed endpoint wrong.
# AIRA_OLLAMA_TIMEOUT_SECONDS=300

# ---- Response schemas and embedding batches (FRD-112, FRD-113) ------------------------
# A response schema is caller-supplied structure whose recursion is caller-controlled. It is
# forwarded and never executed, so these bounds are the whole of the gateway's exposure to it.
# AIRA_MAX_RESPONSE_SCHEMA_BYTES=32768
# AIRA_MAX_RESPONSE_SCHEMA_DEPTH=8
# AIRA_MAX_RESPONSE_SCHEMA_PROPERTIES=256
#
# Embedding batch bounds. **Choose these with the configured rate limits in view**: a batch of n
# texts weighs n against a use case's bucket, so a batch bound larger than any bucket's capacity
# makes large batches fail permanently. The refusal names which of the two said no.
# AIRA_MAX_EMBEDDING_BATCH=256
# AIRA_MAX_EMBEDDING_CHARS=1000000

# ---- Management deployment (ADR-0007) -------------------------------------------------
# Outside `local`, the management backend refuses to start while it still carries the
# development defaults. Set these from Vault for anything that is not a laptop.
# AIRA_ENVIRONMENT=production
# AIRA_SECRET_KEY=<unique-random-secret>
# AIRA_ALLOWED_HOSTS=aira.example.com
# AIRA_DEBUG=false

# ---- Microsoft Foundry / Azure OpenAI (FRD-120) ----------------------------------------
# Registered only when the endpoint, a credential and at least one deployment are all present.
# A deployment name is chosen by whoever created the resource and says nothing reliable about the
# model — so the mapping is declared, never inferred. Getting it wrong does not fail: a deployment
# name has no price, and unpriced traffic is counted apart rather than as zero, so the spend figure
# would quietly stop being complete.
#   model=deployment[|region][|embed], entries separated by ';'
# AIRA_FOUNDRY_ENDPOINT=https://contoso.openai.azure.com
# AIRA_FOUNDRY_API_KEY=
# AIRA_FOUNDRY_DEPLOYMENTS=gpt-4o=prod-gpt4o|westeurope;text-embedding-3-small=prod-emb|westeurope|embed
# Pinned rather than "latest": a version that moves on its own changes response shapes with no
# deploy, and the first sign is a mapper reading a field that stopped being sent.
# AIRA_FOUNDRY_API_VERSION=2024-10-21

# ---- Secrets (FRD-116) ----------------------------------------------------------------
# Unset = no Vault, environment variables as before. Set = Vault wins over the environment, and a
# Vault that cannot be reached **stops the process** rather than falling back — the fallback is
# what turns a broken secret store into a service that starts, looks healthy, and runs on a stale
# value.
# VAULT_ADDR=https://vault.internal:8200
# VAULT_MOUNT=secret
# VAULT_PATH=aira
# VAULT_NAMESPACE=
# The role id identifies and does not authorise, so it is ordinary configuration.
# VAULT_ROLE_ID=
# The secret-id *is* a secret and must arrive by a path Vault did not provide. Tried in this order:
#   VAULT_SECRET_ID       — an environment variable (CI, simple deployments)
#   VAULT_SECRET_ID_FILE  — a mounted file (Kubernetes projected volume: tmpfs, not a manifest)
#   VAULT_TOKEN           — a development token; `make up` runs Vault in dev mode. Logs a warning.
