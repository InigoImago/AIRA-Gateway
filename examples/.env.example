# The settings every example reads. Copy to .env, fill in, and load it into the shell:
#   set -a; . ./.env; set +a
# The values below are the local stack's; .env itself is never committed.

# The gateway's address and the use case's slug: together the base URL <gateway>/uc/<use-case>.
GATEWAY_URL=http://localhost:8001
USE_CASE=assistant

# Which credential the examples send: key, bearer, service-account or token-as-key
# (the REST examples take query-key as well). The curl script sends every one that is set.
AUTH=key

# An AIRA API key of that use case: console -> the use case -> API keys. Shown once, when issued.
API_KEY=

# A person's Keycloak access token, from your application's sign-in. It expires within minutes.
ACCESS_TOKEN=

# A confidential Keycloak client whose service account may use the use case.
TOKEN_URL=http://localhost:8080/realms/aira/protocol/openid-connect/token
CLIENT_ID=
CLIENT_SECRET=

# Models released to the use case: console -> the use case -> Overview.
MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
SPEECH_MODEL=gemini-2.5-flash-preview-tts
