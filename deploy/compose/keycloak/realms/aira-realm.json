  "clients": [
    {
      "clientId": "aira-gateway",
      "name": "AIRA Gateway (dev)",
      "description": "Public SPA client (dev). Redirect URIs and web origins are pinned on purpose — a wildcard on a public client lets an attacker capture the authorization code. See ADR-0007.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:${AIRA_CONSOLE_PORT:4200}/*",
        "http://127.0.0.1:${AIRA_CONSOLE_PORT:4200}/*",
        "http://${AIRA_CONSOLE_HOST:localhost}:${AIRA_CONSOLE_PORT:4200}/*",
        "https://${AIRA_CONSOLE_HOST:localhost}:${AIRA_CONSOLE_PORT:4200}/*"
      ],
      "webOrigins": [
        "http://localhost:${AIRA_CONSOLE_PORT:4200}",
        "http://127.0.0.1:${AIRA_CONSOLE_PORT:4200}",
        "http://${AIRA_CONSOLE_HOST:localhost}:${AIRA_CONSOLE_PORT:4200}",
        "https://${AIRA_CONSOLE_HOST:localhost}:${AIRA_CONSOLE_PORT:4200}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "aira-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aira-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "aira-integration-tests",
      "name": "Integration tests (dev only)",
      "description": "Service account used by tests/integration to obtain a real realm-signed token. Never enable outside a dev realm.",
