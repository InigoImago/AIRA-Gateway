{
  "realm": "aira",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "use-cases",
      "subGroups": [
        {
          "name": "kundenservice"
        },
        {
          "name": "entwicklung"
        },
        {
          "name": "personalwesen"
        },
        {
          "name": "demo-uc"
        },
        {
          "name": "other-uc"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "aira-gateway",
      "name": "AIRA Gateway (dev)",
      "description": "Public SPA client (dev). Redirect URIs and web origins are pinned on purpose \u2014 a wildcard on a public client lets an attacker capture the authorization code. See ADR-0007.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "aira-integration-tests",
      "name": "Integration tests (dev only)",
      "description": "Service account used by tests/integration to obtain a real realm-signed token. Never enable outside a dev realm.",
      "enabled": true,
      "publicClient": false,
      "secret": "integration-tests-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "aira-integration-tests-member",
      "name": "Integration tests, non-governance (dev only)",
      "description": "Second service account, deliberately without an oversight role: an RBAC test with only one caller proves nothing about who is excluded.",
      "enabled": true,
      "publicClient": false,
      "secret": "integration-tests-member-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "aira-integration-tests-security",
      "name": "Integration tests (dev only)",
      "description": "Service account for the integration suite, carrying it-security. A third account, because who may see every use case and who may stop traffic are different questions.",
      "enabled": true,
      "publicClient": false,
      "secret": "integration-tests-security-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "id": "aira-integration-tests-security"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@demo.aira",
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "global-admin"
      ],
      "groups": []
    },
    {
      "username": "itsec",
      "enabled": true,
      "emailVerified": true,
      "email": "itsec@demo.aira",
      "firstName": "Itsec",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "it-security"
      ],
      "groups": []
    },
    {
      "username": "itgov",
      "enabled": true,
      "emailVerified": true,
      "email": "itgov@demo.aira",
      "firstName": "Itgov",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "it-steuerung"
      ],
      "groups": []
    },
    {
      "username": "ucadmin",
      "enabled": true,
      "emailVerified": true,
      "email": "ucadmin@demo.aira",
      "firstName": "Ucadmin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "use-case-admin"
      ],
      "groups": [
        "/use-cases/kundenservice",
        "/use-cases/entwicklung",
        "/use-cases/demo-uc"
      ]
    },
    {
      "username": "ucuser",
      "enabled": true,
      "emailVerified": true,
      "email": "ucuser@demo.aira",
      "firstName": "Ucuser",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "use-case-user"
      ],
      "groups": [
        "/use-cases/kundenservice",
        "/use-cases/demo-uc"
      ]
    },
    {
      "username": "demo-user",
      "enabled": true,
      "emailVerified": true,
      "email": "demo-user@demo.aira",
      "firstName": "Demo-user",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "use-case-admin"
      ],
      "groups": [
        "/use-cases/demo-uc"
      ]
    },
    {
      "username": "service-account-aira-integration-tests",
      "enabled": true,
      "serviceAccountClientId": "aira-integration-tests",
      "realmRoles": [
        "it-steuerung"
      ]
    },
    {
      "username": "service-account-aira-integration-tests-member",
      "enabled": true,
      "serviceAccountClientId": "aira-integration-tests-member",
      "realmRoles": [
        "use-case-admin"
      ]
    },
    {
      "username": "service-account-aira-integration-tests-security",
      "enabled": true,
      "serviceAccountClientId": "aira-integration-tests-security",
      "realmRoles": [
        "it-security"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "global-admin",
        "description": "Global Administrator \u2014 full administration"
      },
      {
        "name": "it-security",
        "description": "IT Security \u2014 anomaly/incident oversight"
      },
      {
        "name": "it-steuerung",
        "description": "Governance \u2014 organisation-wide read visibility"
      },
      {
        "name": "use-case-admin",
        "description": "Use Case Administrator \u2014 may create use cases"
      },
      {
        "name": "use-case-user",
        "description": "Use Case User \u2014 may consume a use case"
      }
    ]
  }
}
