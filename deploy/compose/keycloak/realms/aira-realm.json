{
  "realm": "aira",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "use-cases",
      "subGroups": [
        { "name": "demo-uc" },
        { "name": "other-uc" }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "aira-gateway",
      "name": "AIRA Gateway (dev)",
      "description": "Public SPA client. Redirect URIs and web origins are pinned to the local dev hosts: a wildcard on a public client lets an attacker redirect the authorization code to a site they control (ADR-0007). Add your own origin here rather than widening it back to '*'.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "emailVerified": true,
      "email": "demo-user@demo.aira",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "demo-password", "temporary": false }
      ],
      "groups": ["/use-cases/demo-uc"]
    }
  ]
}
