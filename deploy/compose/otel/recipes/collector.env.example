# Values the recipes in this directory read (ADR-0024). Copy to ../custom/collector.env, which is
# git-ignored, and fill in what the selected recipe needs; the rest can stay out. Compose passes that
# file to the collector only, and only if it exists. An unset value is absent, so the recipe's
# fallback applies and the collector still starts.

# ---- forward-splunk-hec.yaml ---------------------------------------------------------------------
# The whole URL, path included.
#SPLUNK_HEC_ENDPOINT=https://splunk.internal:8088/services/collector
#SPLUNK_HEC_TOKEN=…
# Spans and logs. Empty means the token's default index.
#SPLUNK_HEC_INDEX=aira
# A metrics index: `mstats` reads nothing else.
#SPLUNK_HEC_METRICS_INDEX=aira_metrics
# With KV_MODE = json for this sourcetype in props.conf, the span attributes are search-time fields.
#SPLUNK_HEC_SOURCETYPE=aira:otel

# ---- forward-oauth2.yaml -------------------------------------------------------------------------
#OAUTH_TOKEN_URL=https://idp.internal/realms/ops/protocol/openid-connect/token
#OAUTH_CLIENT_ID=aira-collector
#OAUTH_CLIENT_SECRET=…
# A YAML list in one value.
#OAUTH_SCOPES=["telemetry.write"]
# The identity provider's CA, if it is behind a private one (put it in ../ca/).
#OAUTH_CA_FILE=/etc/otelcol-contrib/ca/idp-ca.crt

# ---- forward-azure-monitor.yaml ------------------------------------------------------------------
# From the Data Collection Endpoint and Rule; metrics are on a different host.
#AZURE_MONITOR_TRACES_ENDPOINT=https://<dce>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr>/streams/Microsoft-OTLP-Traces/otlp/v1/traces
#AZURE_MONITOR_LOGS_ENDPOINT=https://<dce>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr>/streams/Microsoft-OTLP-Logs/otlp/v1/logs
#AZURE_MONITOR_METRICS_ENDPOINT=https://<dce>.<region>-1.metrics.ingest.monitor.azure.com/dataCollectionRules/<dcr>/streams/Custom-Metrics-Otel/otlp/v1/metrics
# Empty means the system-assigned managed identity.
#AZURE_MONITOR_CLIENT_ID=
